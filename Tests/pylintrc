# Pylint for the tests; pytest-testrex's meta suite runs it and fails on any message.
#
# The library is linted by ruff. Tests get pylint's deeper checks too (fakes
# whose calls no longer match the real signature, names a fixture never sets,
# unused results), minus the rules that are pytest idioms rather than defects:
# a fixture is requested by naming it as a parameter (redefined-outer-name,
# unused-argument), tests are described by their names (docstrings,
# invalid-name), and a test reaches into the code under test on purpose
# (protected-access). The repository's own conventions are off too: %
# formatting, `import joybox.x as x`, and no line length.

[MAIN]
py-version = 3.12
jobs = 0

[TYPECHECK]
# Attributes of the MagicMocks tests swap in, which pylint may infer as the real object
generated-members = assert_.*,return_value,side_effect,call_args,call_args_list,call_count,called,mock_calls,method_calls,reset_mock

[BASIC]
good-names = i,j,k,f,e,ex,fd,ip,id,ok,db,fn,cb,kw,vm

[MESSAGES CONTROL]
disable =
    too-many-arguments,
    too-many-positional-arguments,
    too-many-instance-attributes,
    too-many-locals,
    too-many-branches,
    too-many-statements,
    too-many-return-statements,
    too-many-nested-blocks,
    too-many-public-methods,
    too-many-lines,
    too-few-public-methods,
    duplicate-code,
    import-outside-toplevel,
    broad-exception-caught,
    broad-exception-raised,
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    redefined-outer-name,
    unused-argument,
    protected-access,
    invalid-name,
    attribute-defined-outside-init,
    use-implicit-booleaness-not-comparison,
    use-dict-literal,
    consider-using-f-string,
    consider-using-from-import,
    line-too-long,
