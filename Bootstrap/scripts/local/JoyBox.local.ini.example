# JoyBox - local testing config
#
# Copy this to ~/JoyBox.local.ini and point bootstrap.py at it with -c:
#
#   python3 bootstrap.py -a setup -t remote_ubuntu -s 0 -c ~/JoyBox.local.ini \
#       --components nginx certbot cockpit wordpress navidrome oscar
#
# Keeping this in a separate file from ~/JoyBox.ini is what isolates the rehearsal
# from the real server: settings are process-wide, so a second file gives the VM
# its own domain, TLS mode and credentials with no code changes and no risk of
# a local value leaking into a production run.
#
# Only the keys that differ from the defaults are listed. Anything left out falls
# back to Shared/joybox/default_settings.py.

[UserData.Servers]
# Matches what hosts_sync.sh writes into /etc/hosts. .test is reserved by RFC 2606,
# so it cannot collide with a real domain.
domain_name = joybox.test
domain_contact = nobody@joybox.test

# Locally trusted certificate signed by the mkcert CA on this workstation, so the
# browser does not warn. Use "selfsigned" to skip the mkcert dependency and accept
# one warning instead. Never "letsencrypt" here - it cannot validate a .test domain.
tls_mode = mkcert

# Filled in by vm_create.sh, which prints these when the VM comes up.
server_0_host =
server_0_port = 22
server_0_user =
# Key auth, not a password: init_sshd.sh disables password SSH as part of the
# drill, so the deploy path has to be on keys before that runs.
server_0_key_filepath =

[UserData.Backup]
backup_root = /mnt/storage/Backups
backup_keep = 3

# Exercise the encrypted backup path locally before trusting it with real data.
# Generate a throwaway pair with:
#   age-keygen -o ~/.joybox-age-test.key
# The public line it prints goes here; the file path goes in backup_age_identity.
backup_age_recipient =
backup_age_identity =

[UserData.Wordpress]
wordpress_db_pass = localtest
wordpress_db_root_pass = localtest
wordpress_admin_user = admin
wordpress_admin_pass = localtest
wordpress_admin_email = nobody@joybox.test

[UserData.FileBrowser]
filebrowser_user_root = /mnt/storage
filebrowser_admin_user = admin
filebrowser_admin_pass = localtest

[UserData.Navidrome]
navidrome_music_dir = /mnt/storage/Music

[UserData.Audiobookshelf]
audiobookshelf_audio_dir = /mnt/storage/Music/Audiobook
